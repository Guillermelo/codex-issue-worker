# Optional overrides used by the container.
CONFIG_FILE=/app/config.yaml
LOG_LEVEL=INFO
AGENT_BIND_ADDRESS=127.0.0.1
AGENT_PORT=8080

# Git uses these values when the agent creates a commit.
GIT_AUTHOR_NAME=GitHub Issue Agent
GIT_AUTHOR_EMAIL=issue-agent@localhost
GIT_COMMITTER_NAME=GitHub Issue Agent
GIT_COMMITTER_EMAIL=issue-agent@localhost
